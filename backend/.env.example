# Copy to backend/.env. All values optional. Never commit backend/.env.
# COPILOT_DATA_DIR=/absolute/path/to/data     # default: <repo>/data
# COPILOT_PORT=8000
# COPILOT_REFINE_WORKERS=2
# COPILOT_DEFAULT_SEED=20262027
